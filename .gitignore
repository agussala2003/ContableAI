# ──────────────────────────────────────────────────────────────────────────────
#  .NET / C# backend
# ──────────────────────────────────────────────────────────────────────────────
backend/**/bin/
backend/**/obj/
backend/**/TestResults/
backend/**/*.user
backend/**/*.suo
backend/.vs/
backend/src/ContableAI.API/appsettings.Development.json

# Migraciones despliegue (mantener las fuentes, no los artefactos de runtime)
backend/**/*.db
backend/**/*.db-shm
backend/**/*.db-wal

# Certificados AFIP — NUNCA subir al repositorio
backend/certs/*.p12
backend/certs/*.pfx
backend/certs/*.pem
backend/certs/*.key

# Logs generados por Serilog
backend/logs/
backend/**/logs/
!backend/**/logs/.gitkeep

# ──────────────────────────────────────────────────────────────────────────────
#  Angular frontend
# ──────────────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.env
frontend/.env.*

# ──────────────────────────────────────────────────────────────────────────────
#  Variables de entorno y secretos
# ──────────────────────────────────────────────────────────────────────────────
*.env
.env
.env.local
.env.production
.env.development
.env.*.local
appsettings.Production.json

# Plantilla de referencia SIN valores reales — sí se versiona
!.env.template

# ──────────────────────────────────────────────────────────────────────────────
#  IDEs y herramientas de desarrollo local
# ──────────────────────────────────────────────────────────────────────────────
.vs/
.vscode/
.DS_Store
Thumbs.db
.claude/

# ──────────────────────────────────────────────────────────────────────────────
#  Docker
# ──────────────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ──────────────────────────────────────────────────────────────────────────────
#  Tests — solo la carpeta /tests de la RAÍZ (PDFs de muestra de extractos/AFIP).
#  Anclada con "/" para NO ignorar backend/tests (el proyecto de tests .NET, que sí
#  se versiona: sin el ancla, los tests nuevos quedaban fuera del repo).
# ──────────────────────────────────────────────────────────────────────────────
/tests/

#  Datos de prueba que cada dev/CI coloca localmente en backend/tests/TestData.
#  El README de esa carpeta ya decía que los PDFs reales NO se versionan (traen CUIT,
#  razón social, CBU e importes de clientes), pero nada lo impedía: bastaba con copiarlos
#  para correr la regresión y quedaban listos para commitear. Los .txt de fixtures SÍ se
#  versionan — son sintéticos — y por eso la regla es solo sobre binarios de extracto.
backend/tests/TestData/**/*.pdf
backend/tests/TestData/**/*.xlsx
backend/tests/TestData/**/*.csv

# ──────────────────────────────────────────────────────────────────────────────
# Dics - De la carpeta docs solo dejar lo que sea .md
# ──────────────────────────────────────────────────────────────────────────────
docs/*
!docs/**/*.md
