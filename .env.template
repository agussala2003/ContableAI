# ──────────────────────────────────────────────────────────────────────────────
#  ContableAI — Plantilla de variables de entorno
#  Copiá este archivo a `.env` y completá los valores REALES.
#  El `.env` está en .gitignore: NUNCA lo comitees con valores reales.
#  Convención .NET: el doble guión bajo (__) representa jerarquía de configuración
#  (ej: Jwt__Key  →  sección "Jwt", clave "Key").
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL — connection string de la aplicación ────────────────────────────
# Producción: Neon (con pooler). Local: usar el docker-compose de este repo.
# Generá una password nueva si la anterior fue expuesta en el historial de git.
ConnectionStrings__DefaultConnection="Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Channel Binding=Require;"

# ── JWT — clave de firma HMAC-SHA256 ───────────────────────────────────────────
# Mínimo 32 bytes (256 bits) de entropía aleatoria. Generar con:
#   openssl rand -base64 48
# Rotar esta clave invalida TODOS los tokens emitidos (comportamiento deseado).
Jwt__Key="<clave-aleatoria-de-al-menos-32-bytes>"

# ── SMTP / Resend — email transaccional ────────────────────────────────────────
Smtp__Password="<resend-api-key>"

# ── Seed del administrador inicial ─────────────────────────────────────────────
# OBLIGATORIA en Production: si no está definida, la app NO arranca (ver SeedExtensions).
# Mínimo 12 caracteres, fuerte y única.
SEED_ADMIN_PASSWORD="<password-fuerte-min-12-caracteres>"

# ── Frontend — origen permitido por la política de CORS ────────────────────────
Frontend__BaseUrl="http://localhost:4200"

# ──────────────────────────────────────────────────────────────────────────────
#  docker-compose (solo desarrollo local) — credenciales del contenedor Postgres
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password-local-para-docker>
POSTGRES_DB=contableai_dev
